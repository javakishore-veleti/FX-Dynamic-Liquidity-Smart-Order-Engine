{
  "name": "fx-dynamic-liquidity-smart-order-engine",
  "version": "1.0.0",
  "private": true,
  "description": "FX Dynamic Liquidity & Smart Order Routing Engine — monorepo scripts for Middleware services and Portals UIs",
  "scripts": {
    "local:containers:all:start": "bash CICD/Local/docker-all-up.sh",
    "local:containers:all:stop": "bash CICD/Local/docker-all-down.sh",
    "local:containers:all:status": "bash CICD/Local/all-status.sh",
    "build:middleware": "mvn -DskipTests package",
    "build:quote": "mvn -pl Middleware/fx-quote-service -am -DskipTests package",
    "build:qualify": "mvn -pl Middleware/fx-qualify-service -am -DskipTests package",
    "build:route-exec": "mvn -pl Middleware/fx-route-exec-service -am -DskipTests package",
    "build:admin": "mvn -pl Middleware/fx-admin-service -am -DskipTests package",
    "build:topology": "mvn -pl Middleware/fx-topology-service -am -DskipTests package",
    "build:agent-orchestrator": "mvn -pl Middleware/fx-agent-orchestrator-service -am -DskipTests package",
    "run:quote": "mvn -pl Middleware/fx-quote-service spring-boot:run",
    "run:qualify": "mvn -pl Middleware/fx-qualify-service spring-boot:run",
    "run:route-exec": "mvn -pl Middleware/fx-route-exec-service spring-boot:run",
    "run:admin": "mvn -pl Middleware/fx-admin-service spring-boot:run",
    "run:topology": "mvn -pl Middleware/fx-topology-service spring-boot:run",
    "run:agent-orchestrator": "mvn -pl Middleware/fx-agent-orchestrator-service spring-boot:run",
    "run:quote:postgres": "mvn -pl Middleware/fx-quote-service spring-boot:run -Dspring-boot.run.profiles=local-postgres",
    "run:qualify:postgres": "mvn -pl Middleware/fx-qualify-service spring-boot:run -Dspring-boot.run.profiles=local-postgres",
    "run:route-exec:postgres": "mvn -pl Middleware/fx-route-exec-service spring-boot:run -Dspring-boot.run.profiles=local-postgres",
    "run:admin:postgres": "mvn -pl Middleware/fx-admin-service spring-boot:run -Dspring-boot.run.profiles=local-postgres",
    "run:topology:postgres": "mvn -pl Middleware/fx-topology-service spring-boot:run -Dspring-boot.run.profiles=local-postgres",
    "run:agent-orchestrator:postgres": "mvn -pl Middleware/fx-agent-orchestrator-service spring-boot:run -Dspring-boot.run.profiles=local-postgres",
    "run:quote:full": "mvn -pl Middleware/fx-quote-service spring-boot:run -Dspring-boot.run.profiles=local-postgres,load-redis,load-kafka",
    "run:qualify:full": "mvn -pl Middleware/fx-qualify-service spring-boot:run -Dspring-boot.run.profiles=local-postgres,load-redis,load-kafka",
    "run:route-exec:full": "mvn -pl Middleware/fx-route-exec-service spring-boot:run -Dspring-boot.run.profiles=local-postgres,load-redis,load-kafka",
    "run:admin:full": "mvn -pl Middleware/fx-admin-service spring-boot:run -Dspring-boot.run.profiles=local-postgres,load-redis,load-kafka",
    "run:topology:full": "mvn -pl Middleware/fx-topology-service spring-boot:run -Dspring-boot.run.profiles=local-postgres,load-redis,load-kafka",
    "run:agent-orchestrator:full": "mvn -pl Middleware/fx-agent-orchestrator-service spring-boot:run -Dspring-boot.run.profiles=local-postgres,load-redis,load-kafka"
  },
  "engines": {
    "node": ">=20"
  },
  "workspaces": [
    "Portals/*"
  ]
}
