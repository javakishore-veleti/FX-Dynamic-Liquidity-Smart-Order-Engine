{
  "name": "fx-dynamic-liquidity-smart-order-engine",
  "version": "1.0.0",
  "private": true,
  "description": "FX Dynamic Liquidity & Smart Order Routing Engine \u2014 monorepo scripts for Middleware services and Portals UIs",
  "scripts": {
    "local:containers:all:start": "bash CICD/Local/docker-all-up.sh",
    "local:containers:all:stop": "bash CICD/Local/docker-all-down.sh",
    "local:containers:all:status": "bash CICD/Local/all-status.sh",
    "local:middleware:all:start": "bash CICD/Local/middleware-all-start.sh",
    "local:middleware:all:start-with-postgres": "FX_SOR_SPRING_PROFILES=local-postgres bash CICD/Local/middleware-all-start.sh",
    "local:middleware:all:stop": "bash CICD/Local/middleware-all-stop.sh",
    "local:middleware:all:status": "bash CICD/Local/middleware-all-status.sh",
    "local:portals:all:start": "bash CICD/Local/portals-all-start.sh",
    "local:portals:all:stop": "bash CICD/Local/portals-all-stop.sh",
    "local:portals:all:status": "bash CICD/Local/portals-all-status.sh",
    "local:portal:admin": "npm --workspace Portals/fx-admin-portal start",
    "local:portal:corporate": "npm --workspace Portals/fx-corporate-portal start",
    "local:portal:retail": "npm --workspace Portals/fx-retail-portal start",
    "local:middleware:quote": "mvn -pl Middleware/fx-quote-service spring-boot:run",
    "local:middleware:qualify": "mvn -pl Middleware/fx-qualify-service spring-boot:run",
    "local:middleware:route-exec": "mvn -pl Middleware/fx-route-exec-service spring-boot:run",
    "local:middleware:admin": "mvn -pl Middleware/fx-admin-service spring-boot:run",
    "local:middleware:topology": "mvn -pl Middleware/fx-topology-service spring-boot:run",
    "local:middleware:topology-mcp": "mvn -pl Middleware/fx-topology-mcp-server spring-boot:run",
    "local:middleware:agent-orchestrator": "mvn -pl Middleware/fx-agent-orchestrator-service spring-boot:run",
    "local:middleware:quote:postgres": "mvn -pl Middleware/fx-quote-service spring-boot:run -Dspring-boot.run.profiles=local-postgres",
    "local:middleware:qualify:postgres": "mvn -pl Middleware/fx-qualify-service spring-boot:run -Dspring-boot.run.profiles=local-postgres",
    "local:middleware:route-exec:postgres": "mvn -pl Middleware/fx-route-exec-service spring-boot:run -Dspring-boot.run.profiles=local-postgres",
    "local:middleware:admin:postgres": "mvn -pl Middleware/fx-admin-service spring-boot:run -Dspring-boot.run.profiles=local-postgres",
    "local:middleware:topology:postgres": "mvn -pl Middleware/fx-topology-service spring-boot:run -Dspring-boot.run.profiles=local-postgres",
    "local:middleware:topology-mcp:postgres": "mvn -pl Middleware/fx-topology-mcp-server spring-boot:run -Dspring-boot.run.profiles=local-postgres",
    "local:middleware:agent-orchestrator:postgres": "mvn -pl Middleware/fx-agent-orchestrator-service spring-boot:run -Dspring-boot.run.profiles=local-postgres",
    "local:middleware:quote:full": "mvn -pl Middleware/fx-quote-service spring-boot:run -Dspring-boot.run.profiles=local-postgres,load-redis,load-kafka",
    "local:middleware:qualify:full": "mvn -pl Middleware/fx-qualify-service spring-boot:run -Dspring-boot.run.profiles=local-postgres,load-redis,load-kafka",
    "local:middleware:route-exec:full": "mvn -pl Middleware/fx-route-exec-service spring-boot:run -Dspring-boot.run.profiles=local-postgres,load-redis,load-kafka",
    "local:middleware:admin:full": "mvn -pl Middleware/fx-admin-service spring-boot:run -Dspring-boot.run.profiles=local-postgres,load-redis,load-kafka",
    "local:middleware:topology:full": "mvn -pl Middleware/fx-topology-service spring-boot:run -Dspring-boot.run.profiles=local-postgres,load-redis,load-kafka",
    "local:middleware:topology-mcp:full": "mvn -pl Middleware/fx-topology-mcp-server spring-boot:run -Dspring-boot.run.profiles=local-postgres,load-redis,load-kafka",
    "local:middleware:agent-orchestrator:full": "mvn -pl Middleware/fx-agent-orchestrator-service spring-boot:run -Dspring-boot.run.profiles=local-postgres,load-redis,load-kafka",
    "local:topology-mcp:python": "bash CICD/Local/python-topology-mcp-start.sh",
    "local:topology-mcp:python:postgres": "MCP_AUDIT_DATABASE_URL=postgresql+psycopg://fx_sor:fx_sor@localhost:5432/fx_topology_mcp_db bash CICD/Local/python-topology-mcp-start.sh",
    "local:agent-orchestrator:python": "bash CICD/Local/python-agent-orchestrator-start.sh",
    "local:agent-orchestrator:python:postgres": "FX_AGENT_ORCHESTRATOR_DB_URL=postgresql+psycopg://fx_sor:fx_sor@localhost:5432/fx_agent_orchestrator_db bash CICD/Local/python-agent-orchestrator-start.sh",
    "local:python:all:start": "bash CICD/Local/python-all-start.sh",
    "local:python:all:stop": "bash CICD/Local/python-all-stop.sh",
    "local:python:all:status": "bash CICD/Local/python-all-status.sh",
    "local:model-tuning": "bash CICD/Local/python-model-tuning-run.sh",
    "local:model-tuning:all": "bash Agentic-Python/fx-model-tuning/scripts/run_all_use_cases.sh",
    "local:python:uv:sync": "bash CICD/Local/python-uv-bootstrap.sh Agentic-Python/fx-topology-mcp-server fx-topology-mcp 'FX Topology MCP Server' && bash CICD/Local/python-uv-bootstrap.sh Agentic-Python/fx-agent-orchestrator-service fx-agent-orchestrator 'FX Agent Orchestrator Service' && bash CICD/Local/python-uv-bootstrap.sh Agentic-Python/fx-model-tuning fx-model-tuning 'FX Model Fine-Tuning Pipeline'",
    "build:portals": "npm --workspace Portals/fx-admin-portal run build && npm --workspace Portals/fx-corporate-portal run build && npm --workspace Portals/fx-retail-portal run build",
    "build:middleware": "mvn -DskipTests package",
    "build:quote": "mvn -pl Middleware/fx-quote-service -am -DskipTests package",
    "build:qualify": "mvn -pl Middleware/fx-qualify-service -am -DskipTests package",
    "build:route-exec": "mvn -pl Middleware/fx-route-exec-service -am -DskipTests package",
    "build:admin": "mvn -pl Middleware/fx-admin-service -am -DskipTests package",
    "build:topology": "mvn -pl Middleware/fx-topology-service -am -DskipTests package",
    "build:topology-mcp": "mvn -pl Middleware/fx-topology-mcp-server -am -DskipTests package",
    "build:agent-orchestrator": "mvn -pl Middleware/fx-agent-orchestrator-service -am -DskipTests package",
    "local:llm-gateway:start": "bash CICD/Local/llm-gateway-start.sh",
    "local:llm-gateway:stop": "bash CICD/Local/llm-gateway-stop.sh",
    "local:llm-gateway:status": "bash CICD/Local/llm-gateway-status.sh",
    "local:aiops:start": "bash CICD/Local/aiops-start.sh",
    "local:aiops:stop": "bash CICD/Local/aiops-stop.sh",
    "local:aiops:status": "bash CICD/Local/aiops-status.sh",
    "local:middleware:liquibase:all:start": "bash CICD/Local/Liquibase/liquibase-all-start.sh",
    "local:middleware:liquibase:all:status": "bash CICD/Local/Liquibase/liquibase-all-status.sh"
  },
  "engines": {
    "node": ">=20"
  },
  "workspaces": [
    "Portals/*"
  ]
}
